# Copy to .env.local (git-ignored) and fill in from Supabase → Project Settings → API.
# Add the same two to Vercel → Project → Settings → Environment Variables.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# Turns on the "Pay deposit" button once /api/checkout exists (src/lib/payments.js).
# VITE_PAYMONGO=on
